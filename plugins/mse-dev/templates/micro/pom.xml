<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 独立业务工程：parent 指向基座 mse-starter-parent（编译/插件/BOM/仓库统一收编，随框架 mvn install 发布），
         仅通过 BOM 消费基座发布件（积木式组装），不进根 pom 聚合 -->
    <parent>
        <groupId>com.github.magoo-lau.mse-framework</groupId>
        <artifactId>mse-starter-parent</artifactId>
        <version>{{mseVersion}}</version>
        <relativePath/>
    </parent>

    <groupId>com.github.magoo-lau.mse-modules</groupId>
    <artifactId>mse-{{biz}}</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>mse-{{biz}}</name>
    <description>{{description}}</description>

    <modules>
        {{#IF:API}}<module>{{biz}}-api</module>
        {{/IF:API}}<module>{{biz}}-service</module>
        <module>{{biz}}-boot</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- 本工程模块 -->
            {{#IF:API}}<dependency>
                <groupId>com.github.magoo-lau.mse-modules</groupId>
                <artifactId>{{biz}}-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            {{/IF:API}}<dependency>
                <groupId>com.github.magoo-lau.mse-modules</groupId>
                <artifactId>{{biz}}-service</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <repositories>
        <repository>
            <id>jitpack</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>
</project>
