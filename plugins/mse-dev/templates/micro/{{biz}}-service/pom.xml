<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.github.magoo-lau.mse-modules</groupId>
        <artifactId>mse-{{biz}}</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>{{biz}}-service</artifactId>
    <name>{{biz}}-service</name>
    <description>{{description}}——业务积木（纯 jar，无 main，SPI 自装配）：引入 jar 即得 Controller/Service/Mapper 全部能力</description>

    <dependencies>
        {{#IF:API}}<!-- 自有契约积木：对外 RPC 契约的实现方 -->
        <dependency>
            <groupId>com.github.magoo-lau.mse-modules</groupId>
            <artifactId>{{biz}}-api</artifactId>
        </dependency>
        {{/IF:API}}<!-- 基座技术积木（starter-* 内部装配件：自动装配随 jar 走，工具本体经其传递带入） -->
        <dependency>
            <groupId>com.github.magoo-lau.mse-framework</groupId>
            <artifactId>starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.magoo-lau.mse-framework</groupId>
            <artifactId>starter-mybatis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.magoo-lau.mse-framework</groupId>
            <artifactId>starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.magoo-lau.mse-framework</groupId>
            <artifactId>starter-rpc</artifactId>
        </dependency>
        <!-- 按需启用 MQ（工具类型 common-mq 编译期 + boot 层引 mq-starter 装配）：
        <dependency>
            <groupId>com.github.magoo-lau.mse-framework</groupId>
            <artifactId>common-mq</artifactId>
        </dependency>
        -->
        <!-- 按需启用 Seata：仅当本模块直接写 @GlobalTransactional 注解时编译期引入（运行期由 micro-starter 内置，
             单体类路径无 seata 时该注解被 JVM 静默忽略、双注解退化为 @Transactional）：
        <dependency>
            <groupId>com.github.magoo-lau.mse-framework</groupId>
            <artifactId>starter-seata</artifactId>
            <optional>true</optional>
        </dependency>
        -->
        <!-- 基座契约积木：跨模块 RPC 唯一合法依赖 -->
        <dependency>
            <groupId>com.github.magoo-lau.mse-framework</groupId>
            <artifactId>api-tenant</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.magoo-lau.mse-framework</groupId>
            <artifactId>api-system</artifactId>
        </dependency>
    </dependencies>
</project>
