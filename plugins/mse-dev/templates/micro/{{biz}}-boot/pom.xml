<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.github.magoo-lau.mse-modules</groupId>
        <artifactId>mse-{{biz}}</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>{{biz}}-boot</artifactId>
    <name>{{biz}}-boot</name>
    <description>{{description}}——微服务启动器：micro-starter + {{biz}}-service；application.yaml 经 spring.config.import 接入 Nacos 配置中心，mse.rpc.mode 默认 dubbo，鉴权经契约消费 mse-system，启动即注册供网关 lb://{{appName}} 路由</description>

    <dependencies>
        <!-- 微服务形态入口启动器：Nacos 配置/注册 + Dubbo RPC（mse.rpc.mode 默认 dubbo）+ starter-bridge 基座契约消费桥接
             （鉴权数据源 @SaCheckPermission / 独立库租户路由 / 操作日志 RPC 回退，本服务不打包基座 HTTP 接口）
             + Seata 内置（MSE_SEATA_ENABLED 开关）+ actuator + 三方言 JDBC 驱动 -->
        <dependency>
            <groupId>com.github.magoo-lau.mse-framework</groupId>
            <artifactId>micro-starter</artifactId>
        </dependency>
        <!-- 自有业务积木 -->
        <dependency>
            <groupId>com.github.magoo-lau.mse-modules</groupId>
            <artifactId>{{biz}}-service</artifactId>
        </dependency>
        <!-- 按需启用 MQ（装配入口；工具类型 common-mq 由 service 模块携带。同步：Nacos 配置 mse-{{biz}}.yaml）：
        <dependency>
            <groupId>com.github.magoo-lau.mse-framework</groupId>
            <artifactId>mq-starter</artifactId>
        </dependency>
        -->
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
